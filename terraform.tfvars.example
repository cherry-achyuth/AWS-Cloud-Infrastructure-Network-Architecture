# ==============================================================================
# terraform.tfvars.example
# ==============================================================================
# Example variable definition file.
# To customize your deployment:
# 1. Copy this file to 'terraform.tfvars':
#    cp terraform.tfvars.example terraform.tfvars
# 2. Modify values according to your needs.
# 3. Note: 'terraform.tfvars' is ignored by Git to prevent committing sensitive values.

# Target AWS Region (Default: Mumbai)
aws_region   = "ap-south-1"
project_name = "aws-network-architecture"
environment  = "dev"

# VPC and Subnet CIDRs
vpc_cidr               = "10.0.0.0/16"
availability_zones     = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs   = ["10.0.11.0/24", "10.0.12.0/24"]

# Compute Configuration (Disabled by default to avoid accidental costs)
enable_ec2_instance = false
ec2_instance_type   = "t2.micro"

# Security Configuration
# Set your public IP address in CIDR notation (e.g. "203.0.113.50/32") to enable SSH.
# Leave empty ("") to disable SSH ingress entirely. Never use "0.0.0.0/0".
admin_ssh_cidr = ""

# Existing AWS Key Pair name for SSH (optional)
ec2_key_name = ""
